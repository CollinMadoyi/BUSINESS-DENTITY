DEBUG=False
SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters

# PostgreSQL URLs. Use the pooled URL for web requests and direct URL for migrations.
DATABASE_URL=replace-with-neon-pooled-connection-string
DATABASE_URL_UNPOOLED=replace-with-neon-direct-connection-string

# Optional canonical public URL. Render's assigned hostname and localhost in DEBUG are defaults.
# SITE_URL=https://your-domain.example

# Optional local Neon Object Storage config. Keep credentials out of source control.
# USE_NEON_OBJECT_STORAGE=True
# AWS_STORAGE_BUCKET_NAME=digital-business-id-media
# AWS_ENDPOINT_URL_S3=https://your-branch.storage.c-1.us-east-2.aws.neon.tech
# AWS_REGION=us-east-2
# AWS_ACCESS_KEY_ID=your-storage-credential-id
# AWS_SECRET_ACCESS_KEY=your-storage-secret
